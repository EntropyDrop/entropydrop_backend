# Build from the parent directory containing the backend and shared engine repositories.
FROM node:24-bookworm-slim AS runtime-build
WORKDIR /workspace/entropydrop_space_engine
COPY entropydrop_space_engine/package.json entropydrop_space_engine/package-lock.json ./
RUN npm ci
WORKDIR /workspace/entropydrop_backend/space/runtime
COPY entropydrop_backend/space/runtime/package.json entropydrop_backend/space/runtime/package-lock.json entropydrop_backend/space/runtime/.npmrc ./
RUN npm ci
WORKDIR /workspace/entropydrop_space_engine
COPY entropydrop_space_engine/src ./src
WORKDIR /workspace/entropydrop_backend/space/runtime
COPY entropydrop_backend/space/runtime ./
RUN npm run build && npm prune --omit=dev

FROM python:3.10-slim-bookworm AS runtime
WORKDIR /app
COPY --from=runtime-build /usr/local/bin/node /usr/local/bin/node
COPY entropydrop_backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY entropydrop_backend/*.py ./
COPY entropydrop_backend/routers ./routers
COPY entropydrop_backend/space/*.py ./space/
COPY entropydrop_backend/space/contracts ./space/contracts
COPY entropydrop_backend/space/agent ./space/agent
COPY entropydrop_backend/space/migrations ./space/migrations
COPY entropydrop_backend/space/alembic.ini ./space/alembic.ini
COPY --from=runtime-build /workspace/entropydrop_backend/space/runtime/dist ./space/runtime/dist
COPY --from=runtime-build /workspace/entropydrop_backend/space/runtime/node_modules ./space/runtime/node_modules
RUN useradd --uid 10001 --create-home runner
USER runner
CMD ["python", "-m", "space.hosting_worker"]

# The default target verifies on the build host. Cross-architecture builders may
# export --target runtime and must run hosting_smoke on the native deployment host;
# emulation can exceed the real script CPU budget even for the smoke fixture.
FROM runtime AS verified
RUN DATABASE_URL=sqlite:///:memory: python -m space.hosting_smoke
